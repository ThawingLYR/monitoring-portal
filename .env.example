tilsig_username=<tilsig_username>
tilsig_password=<tilsig_password>
frost_client_id=<frost_client_id>

# Netatmo. See src/datasource/netatmo.md for how to obtain these.
netatmo_client_id=<netatmo_client_id>
netatmo_client_secret=<netatmo_client_secret>
# Used once to bootstrap the token store; rotated and then kept in secrets/secrets.enc.
netatmo_first_refresh_token=<netatmo_first_refresh_token>
# Must equal the period of the scheduled collection job.
NETATMO_MAX_AGE_MINUTES=15

map_geomorph_key=<map_geomorph_key>

# Fernet key encrypting secrets/secrets.enc. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
local_store_secret_key=<local_store_secret_key>
map_geomorph_key=<map_geomorph_key>
map_risk_key=<map_risk_key>
map_ground_ice_key=<map_ground_ice_key>
map_bedrock_key=<map_bedrock_key>
